{
  "expo": {
    "name": "DPH AI",
    "slug": "dph-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/dph.png",
    "scheme": "tsdphapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCcjU3j7OrG6XD8LYtPXNO5e0jiJNM8_AE"
        }
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/dph.png",
        "backgroundImage": "./assets/images/dph.png",
        "monochromeImage": "./assets/images/dph.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.aravindh0598.ts_dph_app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/dph.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow location for geotagging."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow camera for evidence photos."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/dph.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
